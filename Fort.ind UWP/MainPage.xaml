<Page
    x:Class="Fort.ind_UWP.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Fort.ind_UWP"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <!-- Accelerators are declared here rather than hooked off CoreWindow.KeyDown.
         The old handler sat on the window, so it fired for every keystroke reaching the app
         regardless of what had focus - including while a ContentDialog was up, where Ctrl+F
         would pull focus out of the modal dialog and into the nav search box behind it.
         KeyboardAccelerator routes from the focused element up its own ancestor chain instead,
         and a dialog's content lives in the popup root rather than under this page, so the two
         no longer overlap. It also drops the manual Control key-state polling and the
         attach/detach bookkeeping the window handler needed to avoid leaking. -->
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="FocusSearchAccelerator_Invoked"/>
        <KeyboardAccelerator Key="Escape" Invoked="ClearSearchAccelerator_Invoked"/>
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!-- The "page refresh" transition, hand-rolled for the inline content host.
             ContentFrame gets this animation for free (a Frame applies NavigationThemeTransition
             on navigation, and its default is page refresh), but the inline panels are switched
             by Visibility inside a single StackPanel, and no theme transition fires for that.
             The result was one nav gesture with two different motions depending on which item
             the user clicked. Slide-up + fade-in is what page refresh is defined as, so this
             reproduces it: 24px is between the 40px the settings list uses for a whole section
             and the 20px its nested rows use.

             Both properties animate off the UI thread (Opacity and a RenderTransform are
             independent animations), so no EnableDependentAnimation is needed. -->
        <CubicEase x:Key="PanelEnterEase" EasingMode="EaseOut"/>

        <!-- First-run welcome dialog *content*, as a template rather than a live ContentDialog.
             It used to be assembled element by element in code-behind, where it set FontSize and
             Opacity numerically and sat outside the type ramp the rest of the app follows.

             Declaring a whole ContentDialog in the page tree fixed that but cost the open
             animation: a dialog instance that has already been loaded and shown once does not
             replay its entrance transition on the next ShowAsync, and this dialog is deliberately
             re-showable from Settings. Keeping the markup as a DataTemplate and stamping a fresh
             copy per show gets both - ramp styles and localisable markup, and a dialog that is
             genuinely new every time, which is what the animation keys off. -->
        <DataTemplate x:Key="WelcomeDialogContentTemplate">
            <StackPanel Spacing="12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="24"
                            Margin="0,8,0,8">
                    <FontIcon Glyph="&#xE734;" FontSize="32"/>
                    <FontIcon Glyph="&#xE9A1;" FontSize="32"/>
                    <FontIcon Glyph="&#xE774;" FontSize="32"/>
                </StackPanel>

                <TextBlock Text="Welcome to the beta version of fort.desktop, there's still a lot missing right now and some things may be broken. we hope you enjoy the beta as much as we do!"
                           Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Opacity="0.9"/>

                <CheckBox x:Name="WelcomeDontShowCheckBox"
                          Content="dont show me this again >:("
                          Margin="0,4,0,0"/>
            </StackPanel>
        </DataTemplate>

        <Storyboard x:Key="PanelEnterStoryboard">
            <DoubleAnimation Storyboard.TargetName="ContentPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.3"
                             EasingFunction="{StaticResource PanelEnterEase}"/>
            <DoubleAnimation Storyboard.TargetName="ContentPanelTransform"
                             Storyboard.TargetProperty="Y"
                             From="24" To="0"
                             Duration="0:0:0.3"
                             EasingFunction="{StaticResource PanelEnterEase}"/>
        </Storyboard>
    </Page.Resources>

    <!-- The surface brushes this page paints with (AppSurfaceAcrylicBrush, the nav pane, cards)
         are defined per-theme in App.xaml's ThemeDictionaries. They are deliberately NOT
         redeclared here: a page-level copy shadows the themed one for this page's whole subtree,
         and being outside a theme dictionary it would never repaint on a theme change.

         RootGrid's background is owned by MainPage.ApplyTintColor, which paints either the themed
         surface acrylic or the user's tint. The value below only covers the moment before the
         constructor's first ApplyTintColor call (and design time). -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Height is driven by CoreTitleBar.Height in SetupTitleBar/OnTitleBarLayoutMetricsChanged,
                 not pinned to 32: the system title bar is taller in tablet mode and changes with
                 some accessibility settings, and a hardcoded row lets the caption buttons hang
                 outside the drag region. Auto lets the handler's assignment win. -->
            <RowDefinition x:Name="TitleBarRow" Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom Title Bar Area.
             Background="Transparent" is load-bearing, not cosmetic: a Grid with no background
             does not hit test, and Window.SetTitleBar would hand the system a region nothing
             can actually be dragged by.

             The two padding columns are sized from SystemOverlayLeftInset/RightInset rather than
             a fixed Margin, so the background still paints *under* the caption buttons (which
             this app makes transparent) while no content is ever placed beneath them. Which side
             the buttons land on is not fixed - it flips in RTL - so both ends are reserved and
             the handler assigns whichever the system reports. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="32"
              Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TitleBarLeftInset" Width="0"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="TitleBarRightInset" Width="0"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="1"
                       Text="Fort.ind"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"/>

            <!-- Loading Indicator for Sitemap. In the middle column, so it cannot end up
                 underneath the caption buttons the way a right-aligned child of the whole
                 title bar did. -->
            <ProgressRing x:Name="LoadingIndicator"
                          Grid.Column="1"
                          IsActive="False"
                          Visibility="Collapsed"
                          Width="16"
                          Height="16"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"
                          Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
        </Grid>

        <!-- Main Content -->
        <!-- IsBackButtonVisible is Collapsed, as it always has been. Showing the pane's back
             button was tried and reverted: it sits in the same stack as the toggle button and
             is sized by yet another independent resource, and getting it to line up turned into
             a long chase for no real gain - it would have been enabled on exactly one screen
             (LoginPage returning to ProfilePage), which already offers "skip" and "cancel".

             Back navigation itself is still wired up and still works there: MainPage handles
             SystemNavigationManager.BackRequested, so Alt+Left, the mouse back button and the
             tablet-mode shell button all reach the content Frame. Only the pane button is gone.

             Note this is the *platform* NavigationView (no muxc: prefix), not WinUI 2's. The two
             share an article but not an API surface: IsTitleBarAutoPaddingEnabled, for instance,
             exists only on the WinUI control, so the title-bar padding it describes is not
             something this control does or can be told not to do. -->
        <NavigationView x:Name="NavView"
                         Grid.Row="1"
                         PaneDisplayMode="Auto"
                         CompactPaneLength="48"
                         OpenPaneLength="320"
                         IsBackButtonVisible="Collapsed"
                         IsSettingsVisible="True"
                         IsPaneToggleButtonVisible="True"
                         ItemInvoked="NavView_ItemInvoked"
                         Loaded="NavView_Loaded"
                         DisplayModeChanged="NavView_DisplayModeChanged"
                         Background="Transparent">

            <NavigationView.Resources>
                <!-- Every pane glyph must centre on 24px (half of the 48px compact pane).
                     The toggle button is sized by its own resource, not CompactPaneLength,
                     so it has to be widened to 48 as well or the hamburger sits 4px left. -->
                <x:Double x:Key="NavigationViewCompactPaneLength">48</x:Double>
                <x:Double x:Key="PaneToggleButtonWidth">48</x:Double>
                <Thickness x:Key="NavigationViewItemIconBoxMargin">16,12,16,12</Thickness>
            </NavigationView.Resources>

            <!-- Page titles live here rather than in the content, so the floating pane
                 toggle button cannot overlap them in Minimal mode. The header host
                 already carries a 12px left margin (48px in Minimal, to clear the
                 toggle button), so 12 more lands the text on the content's 24px
                 padding, and leaves a 12px gap after the toggle button in Minimal. -->
            <NavigationView.HeaderTemplate>
                <DataTemplate>
                    <!-- Top, not Center: the header box starts 5px below the toggle
                         button's, so centring here drops the title below the button. -->
                    <TextBlock Text="{Binding}"
                               Style="{StaticResource TitleTextBlockStyle}"
                               VerticalAlignment="Top"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,12,0"/>
                </DataTemplate>
            </NavigationView.HeaderTemplate>

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="NavSearchBox"
                                PlaceholderText="Search for games, pages, and more..."
                                QueryIcon="Find"
                                MaxSuggestionListHeight="400"
                                AutomationProperties.Name="Search for games, pages and more"
                                TextChanged="NavSearchBox_TextChanged"
                                QuerySubmitted="NavSearchBox_QuerySubmitted"
                                SuggestionChosen="NavSearchBox_SuggestionChosen">
                    <AutoSuggestBox.ItemTemplate>
                        <!-- x:Bind against x:DataType rather than {Binding}: compiled at build
                             time instead of reflected per realised row, and OneTime by default
                             inside a DataTemplate, which suits SearchItems that never change
                             after the sitemap is parsed. -->
                        <DataTemplate x:DataType="local:SearchItem">
                            <StackPanel Orientation="Horizontal" Spacing="10" Padding="0,4">
                                <FontIcon Glyph="{x:Bind Icon}"
                                          FontSize="16"
                                          VerticalAlignment="Center"
                                          Opacity="0.8"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Title}"/>
                                    <TextBlock Text="{x:Bind Category}"
                                               Style="{ThemeResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="LatestNews"
                                     ToolTipService.ToolTip="Home"
                                     AccessKey="H"
                                     AutomationProperties.Name="Home"
                                     AutomationProperties.HelpText="Navigate to home page">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Games" Tag="Games"
                                     ToolTipService.ToolTip="Games"
                                     AccessKey="G"
                                     AutomationProperties.Name="Games"
                                     AutomationProperties.HelpText="Browse games">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Play"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Beta Programs" Tag="Betas"
                                     ToolTipService.ToolTip="Beta Programs"
                                     AccessKey="B"
                                     AutomationProperties.Name="Beta Programs"
                                     AutomationProperties.HelpText="Join beta programs">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="PreviewLink"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ProfileNavItem" Content="Your Profile" Tag="Profile"
                                     ToolTipService.ToolTip="Your Profile"
                                     AccessKey="P"
                                     AutomationProperties.Name="Your Profile"
                                     AutomationProperties.HelpText="View and edit your profile">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Contact"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Social" Tag="Social"
                                     ToolTipService.ToolTip="Social"
                                     AccessKey="S"
                                     AutomationProperties.Name="Social"
                                     AutomationProperties.HelpText="Connect with the community">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="People"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- Content Area -->
            <Grid Background="Transparent">
                <!-- Frame for page navigation. -->
                <Frame x:Name="ContentFrame" Visibility="Collapsed"/>

                <ScrollViewer x:Name="ContentScrollViewer">
                    <!-- Padding is set from NavView_DisplayModeChanged: 12px in Minimal, 24px otherwise.
                         The RenderTransform is the target of PanelEnterStoryboard (see Page.Resources):
                         a Frame animates its own page changes, but the inline panels only flip
                         Visibility, so without this the same nav gesture animates for Games/Profile
                         and snaps for everything else. -->
                    <StackPanel x:Name="ContentPanel" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ContentPanelTransform"/>
                        </StackPanel.RenderTransform>
                        <!-- Latest News Content (default view) -->
                        <StackPanel x:Name="LatestNewsPanel" Visibility="Visible">
                            <TextBlock Text="Check back here for the latest updates and announcements."
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="0,0,0,24"/>

                            <!-- News Cards Grid -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- News Card 1 -->
                                <Grid Grid.Column="0"
                                      Background="{ThemeResource CardBackgroundBrush}"
                                      BorderBrush="{ThemeResource CardBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      Padding="20"
                                      MinHeight="180">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Opacity="0.6" Margin="0,0,0,8">
                                            <FontIcon Glyph="&#xE789;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="Welcome!"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="welcome to version 2.0 of fort.uwp!"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="this update fixes many bugs add new features and we also added syncing accounts with fort.social"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="Just now"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                    </StackPanel>
                                </Grid>

                                <!-- News Card 2 -->
                                <Grid Grid.Column="2"
                                      Background="{ThemeResource CardBackgroundBrush}"
                                      BorderBrush="{ThemeResource CardBorderBrush}"
                                      BorderThickness="1"
                                      CornerRadius="4"
                                      Padding="20"
                                      MinHeight="180">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                    Opacity="0.6" Margin="0,0,0,8">
                                            <FontIcon Glyph="&#xE7FC;" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Text="soon! :3"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="soon soon soon-"
                                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="soon you will be able to manage your fort.ind account, view posts from social and play your games from fort1nd.com on windows! if you want to use the full experience for now go to fort1nd.com"
                                                   Style="{StaticResource BodyTextBlockStyle}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumHighBrush}"
                                                   Margin="0,0,0,12"/>
                                        <TextBlock Text="in the future (maybe subject to change)"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </StackPanel>

                        <!-- Games Content is now handled by GamesPage via Frame -->

                        <!-- Betas Content -->
                        <StackPanel x:Name="BetasPanel" Visibility="Collapsed">
                            <TextBlock Text="Access beta versions and early features (coming soon)"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Profile Content is now handled by ProfilePage via Frame -->

                        <!-- Social Content -->
                        <StackPanel x:Name="SocialPanel" Visibility="Collapsed">
                            <TextBlock Text="Social features coming soon"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Settings Content -->
                        <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                            <TextBlock Text="make fort.desktop work for you :3 change it to how you like"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                       Margin="0,0,0,24"/>

                            <StackPanel MaxWidth="700" HorizontalAlignment="Stretch" Spacing="0">
                                <StackPanel.ChildrenTransitions>
                                    <TransitionCollection>
                                        <EntranceThemeTransition FromVerticalOffset="40"/>
                                        <RepositionThemeTransition/>
                                    </TransitionCollection>
                                </StackPanel.ChildrenTransitions>

                                <!-- ═══ Appearance ═══ -->
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <Button Style="{StaticResource ButtonRevealStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinWidth="0"
                                                CornerRadius="0"
                                                Padding="16,12"
                                                Click="AppearanceHeader_Tapped"
                                                AutomationProperties.Name="Appearance"
                                                AutomationProperties.HelpText="Change app theme and background color">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="36" Height="36" CornerRadius="2"
                                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                    <FontIcon Glyph="&#xE771;" FontSize="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Appearance" Style="{StaticResource BaseTextBlockStyle}"/>
                                                    <TextBlock Text="Change app theme and background color"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <FontIcon x:Name="AppearanceChevron" Grid.Column="2" Glyph="&#xE76C;"
                                                          FontSize="12" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform x:Name="AppearanceChevronRotation" Angle="0"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>
                                        <StackPanel x:Name="AppearanceContent" Visibility="Collapsed"
                                                    Padding="20,0,20,16">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                            <Rectangle Height="1" Margin="0,0,0,14"
                                                       Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                       Opacity="0.08"/>
                                            <StackPanel Spacing="16">
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE793;" FontSize="14" Opacity="0.7"/>
                                                        <TextBlock Text="App Theme" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <RadioButton x:Name="ThemeSystemRadio" Content="System Default"
                                                                     GroupName="AppTheme" Tag="Default"
                                                                     Checked="ThemeRadio_Checked"/>
                                                        <RadioButton x:Name="ThemeLightRadio" Content="Light"
                                                                     GroupName="AppTheme" Tag="Light"
                                                                     Checked="ThemeRadio_Checked"/>
                                                        <RadioButton x:Name="ThemeDarkRadio" Content="Dark"
                                                                     GroupName="AppTheme" Tag="Dark"
                                                                     Checked="ThemeRadio_Checked"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE771;" FontSize="14" Opacity="0.7"/>
                                                        <TextBlock Text="Background Tint" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                    <StackPanel Spacing="8">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button x:Name="TintDefaultButton" Tag="Default"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    BorderThickness="2" BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Default"
                                                                    AutomationProperties.Name="Default background tint">
                                                                <FontIcon Glyph="&#xE8D8;" FontSize="14"/>
                                                            </Button>
                                                            <Button x:Name="TintBlueButton" Tag="#1E3A5F"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#1D6FA5" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Navy Blue"
                                                                    AutomationProperties.Name="Navy Blue background tint"/>
                                                            <Button x:Name="TintPurpleButton" Tag="#2D1B69"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#6041B0" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Deep Purple"
                                                                    AutomationProperties.Name="Deep Purple background tint"/>
                                                            <Button x:Name="TintGreenButton" Tag="#0F3D2E"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#1B7A4E" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Forest Green"
                                                                    AutomationProperties.Name="Forest Green background tint"/>
                                                            <Button x:Name="TintRedButton" Tag="#3D1515"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#B03232" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Deep Red"
                                                                    AutomationProperties.Name="Deep Red background tint"/>
                                                            <Button x:Name="TintSlateButton" Tag="#1A1A2E"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#404080" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Dark Slate"
                                                                    AutomationProperties.Name="Dark Slate background tint"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <Button x:Name="TintTealButton" Tag="#0E3A3A"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#1B8A8A" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Deep Teal"
                                                                    AutomationProperties.Name="Deep Teal background tint"/>
                                                            <Button x:Name="TintBronzeButton" Tag="#3D2A0F"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#B07D1B" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Bronze"
                                                                    AutomationProperties.Name="Bronze background tint"/>
                                                            <Button x:Name="TintRoseButton" Tag="#3D1533"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#B03291" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Deep Rose"
                                                                    AutomationProperties.Name="Deep Rose background tint"/>
                                                            <Button x:Name="TintOliveButton" Tag="#2E3D0F"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#6E8A1B" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Olive"
                                                                    AutomationProperties.Name="Olive background tint"/>
                                                            <Button x:Name="TintGraphiteButton" Tag="#232323"
                                                                    Click="TintColorButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    Background="#5A5A5A" BorderThickness="2"
                                                                    BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Graphite"
                                                                    AutomationProperties.Name="Graphite background tint"/>
                                                            <Button x:Name="TintCustomButton"
                                                                    Click="CustomTintButton_Click"
                                                                    Width="40" Height="40" Padding="0" MinWidth="40"
                                                                    BorderThickness="2" BorderBrush="Transparent"
                                                                    ToolTipService.ToolTip="Custom color…"
                                                                    AutomationProperties.Name="Custom background tint">
                                                                <FontIcon x:Name="TintCustomIcon" Glyph="&#xE790;" FontSize="14"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ Data Storage ═══ -->
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <Button Style="{StaticResource ButtonRevealStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinWidth="0"
                                                CornerRadius="0"
                                                Padding="16,12"
                                                Click="StorageHeader_Tapped"
                                                AutomationProperties.Name="Data Storage"
                                                AutomationProperties.HelpText="Manage local storage and view account data">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="36" Height="36" CornerRadius="2"
                                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                    <FontIcon Glyph="&#xEDA2;" FontSize="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Data Storage" Style="{StaticResource BaseTextBlockStyle}"/>
                                                    <TextBlock Text="Manage local storage and view account data"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <FontIcon x:Name="StorageChevron" Grid.Column="2" Glyph="&#xE76C;"
                                                          FontSize="12" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform x:Name="StorageChevronRotation" Angle="0"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>
                                        <StackPanel x:Name="StorageContent" Visibility="Collapsed"
                                                    Padding="20,0,20,16">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                            <Rectangle Height="1" Margin="0,0,0,14"
                                                       Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                       Opacity="0.08"/>
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" Opacity="0.7"/>
                                                    <TextBlock Text="Local Cache"
                                                               Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                                <TextBlock x:Name="CacheDescriptionText"
                                                           Text="Not signed in."
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                           Margin="0,0,0,4"/>
                                                <TextBlock x:Name="StoragePathText"
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumLowBrush}"/>
                                                <TextBlock x:Name="UserCountText"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,4,0,0">
                                                    <Button x:Name="ClearLoginInfoButton"
                                                            Content="Clear login info"
                                                            Click="ClearLoginInfoButton_Click"
                                                            AutomationProperties.Name="Clear login info button"
                                                            AutomationProperties.HelpText="Signs you out and clears the cached fort.social login"/>
                                                    <Button x:Name="ResetAppButton"
                                                            Content="Reset app"
                                                            Click="ResetAppButton_Click"
                                                            Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                                                            AutomationProperties.Name="Reset app button"
                                                            AutomationProperties.HelpText="Signs you out and deletes all cached data and saved settings, resetting the app to a fresh install"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ Live Tile ═══ -->
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <Button Style="{StaticResource ButtonRevealStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinWidth="0"
                                                CornerRadius="0"
                                                Padding="16,12"
                                                Click="TileHeader_Tapped"
                                                AutomationProperties.Name="Live Tile"
                                                AutomationProperties.HelpText="Refresh or clear your Start menu tile">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="36" Height="36" CornerRadius="2"
                                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                    <FontIcon Glyph="&#xE77F;" FontSize="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Live Tile" Style="{StaticResource BaseTextBlockStyle}"/>
                                                    <TextBlock Text="Refresh or clear your Start menu tile"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <FontIcon x:Name="TileChevron" Grid.Column="2" Glyph="&#xE76C;"
                                                          FontSize="12" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform x:Name="TileChevronRotation" Angle="0"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>
                                        <StackPanel x:Name="TileContent" Visibility="Collapsed"
                                                    Padding="20,0,20,16">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                            <Rectangle Height="1" Margin="0,0,0,14"
                                                       Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                       Opacity="0.08"/>
                                            <ToggleSwitch x:Name="TileBadgeToggle"
                                                          Header="Notification badge"
                                                          OnContent="On" OffContent="Off"
                                                          Toggled="TileBadgeToggle_Toggled"/>
                                            <TextBlock Text="The small counter that appears on the app's tile and taskbar icon when the Live Tile has new content."
                                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Margin="0,0,0,14"
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <Button x:Name="RefreshTileButton"
                                                        Click="RefreshTileButton_Click"
                                                        Style="{StaticResource ButtonRevealStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                                        <TextBlock Text="Refresh Live Tile"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="ClearTileButton"
                                                        Click="ClearTileButton_Click"
                                                        Style="{StaticResource ButtonRevealStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                        <TextBlock Text="Clear Live Tile"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ Welcome Dialog ═══ -->
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <Button Style="{StaticResource ButtonRevealStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinWidth="0"
                                                CornerRadius="0"
                                                Padding="16,12"
                                                Click="WelcomeHeader_Tapped"
                                                AutomationProperties.Name="Welcome Dialog"
                                                AutomationProperties.HelpText="Reset the first-run welcome experience">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="36" Height="36" CornerRadius="2"
                                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                    <FontIcon Glyph="&#xEB51;" FontSize="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Welcome Dialog" Style="{StaticResource BaseTextBlockStyle}"/>
                                                    <TextBlock Text="Reset the first-run welcome experience"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <FontIcon x:Name="WelcomeChevron" Grid.Column="2" Glyph="&#xE76C;"
                                                          FontSize="12" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform x:Name="WelcomeChevronRotation" Angle="0"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>
                                        <StackPanel x:Name="WelcomeContent" Visibility="Collapsed"
                                                    Padding="20,0,20,16">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                            <Rectangle Height="1" Margin="0,0,0,12"
                                                       Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                       Opacity="0.08"/>
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="The welcome dialog appears the first time you open the app."
                                                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                                           Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                <Button x:Name="ResetWelcomeButton"
                                                        Click="ResetWelcomeButton_Click"
                                                        Style="{StaticResource ButtonRevealStyle}">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                                        <TextBlock Text="Show Welcome Dialog Again"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ═══ About ═══ -->
                                <Border BorderThickness="0,0,0,1"
                                        BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}">
                                    <StackPanel>
                                        <Button Style="{StaticResource ButtonRevealStyle}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                MinWidth="0"
                                                CornerRadius="0"
                                                Padding="16,12"
                                                Click="AboutHeader_Tapped"
                                                AutomationProperties.Name="About"
                                                AutomationProperties.HelpText="Version info, credits, and more">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="36" Height="36" CornerRadius="2"
                                                      Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                    <FontIcon Glyph="&#xE946;" FontSize="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="About" Style="{StaticResource BaseTextBlockStyle}"/>
                                                    <TextBlock Text="Version info, credits, and more"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                </StackPanel>
                                                <FontIcon x:Name="AboutChevron" Grid.Column="2" Glyph="&#xE76C;"
                                                          FontSize="12" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                          RenderTransformOrigin="0.5,0.5">
                                                    <FontIcon.RenderTransform>
                                                        <RotateTransform x:Name="AboutChevronRotation" Angle="0"/>
                                                    </FontIcon.RenderTransform>
                                                </FontIcon>
                                            </Grid>
                                        </Button>
                                        <StackPanel x:Name="AboutContent" Visibility="Collapsed"
                                                    Padding="20,0,20,16">
                                            <StackPanel.ChildrenTransitions>
                                                <TransitionCollection>
                                                    <EntranceThemeTransition FromVerticalOffset="20"/>
                                                </TransitionCollection>
                                            </StackPanel.ChildrenTransitions>
                                            <Rectangle Height="1" Margin="0,0,0,12"
                                                       Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                       Opacity="0.08"/>
                                            <StackPanel Spacing="12">

                                                <!-- App identity -->
                                                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                                    <Border Width="44" Height="44" CornerRadius="2"
                                                            Background="{ThemeResource SystemControlBackgroundBaseLowBrush}">
                                                        <FontIcon Glyph="&#xE774;" FontSize="22"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="Fort.ind" Style="{StaticResource SubtitleTextBlockStyle}"/>
                                                        <TextBlock x:Name="AboutVersionText"
                                                                   Text="Version"
                                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Rectangle Height="1"
                                                           Fill="{ThemeResource SystemControlForegroundBaseHighBrush}"
                                                           Opacity="0.08"/>

                                                <!-- Links row -->
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <HyperlinkButton NavigateUri="https://fort1nd.com"
                                                                     Padding="8,4" Margin="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE774;" FontSize="12"/>
                                                            <TextBlock Text="Website" Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        </StackPanel>
                                                    </HyperlinkButton>
                                                    <HyperlinkButton x:Name="GitHubLink"
                                                                     NavigateUri="https://github.com/fort-ind/Fort.ind-UWP"
                                                                     Padding="8,4" Margin="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE943;" FontSize="12"/>
                                                            <TextBlock Text="Source Code" Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        </StackPanel>
                                                    </HyperlinkButton>
                                                    <HyperlinkButton x:Name="IssuesLink"
                                                                     NavigateUri="https://github.com/fort-ind/Fort.ind-UWP/issues"
                                                                     Padding="8,4" Margin="0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE946;" FontSize="12"/>
                                                            <TextBlock Text="Report a Bug" Style="{StaticResource CaptionTextBlockStyle}"/>
                                                        </StackPanel>
                                                    </HyperlinkButton>
                                                </StackPanel>

                                                <!-- Footer -->
                                                <StackPanel Orientation="Horizontal" Spacing="6" Opacity="0.4">
                                                    <FontIcon Glyph="&#xE734;" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Text="made with love by fort.ind"
                                                               FontSize="11" VerticalAlignment="Center"/>
                                                    <FontIcon Glyph="&#xE734;" FontSize="10" VerticalAlignment="Center"/>
                                                </StackPanel>

                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

        </NavigationView>

    </Grid>
</Page>
